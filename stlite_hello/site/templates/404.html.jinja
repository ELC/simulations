<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting…</title>
    <script>
      sessionStorage.setItem("redirect", location.href);
      location.replace(
        location.origin + location.pathname.replace(/\/[^/]*$/, "/"),
      );
    </script>
  </head>
  <body></body>
</html>
